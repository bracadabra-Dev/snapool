# Neon Postgres — use pooled for the app, direct for Prisma migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="spaisnap"
R2_PUBLIC_URL_BASE="https://pub-xxxxx.r2.dev"

# Public app URL used for QR codes and share links (no trailing slash)
APP_PUBLIC_URL="http://localhost:5173"

# Server
PORT=3000
NODE_ENV=development

# Video feature (emergency kill switch — false disables all video uploads)
FEATURE_VIDEO_ENABLED=false
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_WEBHOOK_SECRET=""

# Campay payments (leave empty for dev mock checkout)
CAMPAY_API_KEY=""
CAMPAY_WEBHOOK_SECRET=""
CAMPAY_API_URL="https://api.campay.net/api"

# First super admin — user must register this email first, then boot promotes them
SUPER_ADMIN_EMAIL=""
